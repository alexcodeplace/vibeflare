---
import { WorkspaceChats } from '../widgets/WorkspaceChats';

const pathname = Astro.url.pathname;

interface NavLink {
  href: string;
  label: string;
  svg: string;
}

const NAV_LINKS: NavLink[] = [
  { href: '/chat', label: 'Workspace', svg: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>' },
  { href: '/history', label: 'History', svg: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>' },
  { href: '/files', label: 'Projects', svg: '<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2v11z"/>' },
  { href: '/analytics', label: 'Data', svg: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>' },
  { href: '/keys', label: 'API Keys', svg: '<path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>' },
  { href: '/settings', label: 'Settings', svg: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>' },
];
---
<aside id="sidebar" class="hidden lg:flex flex-col w-56 shrink-0 border-r border-[var(--color-border)] bg-[var(--color-surface)] h-full min-h-0">
  <div class="px-4 pt-6 pb-4">
    <span class="text-base font-bold text-[var(--color-accent)]">VibeFlare</span>
  </div>
  <nav aria-label="Main navigation" class="flex min-h-0 flex-col gap-1 overflow-y-auto px-3 flex-1">
    {NAV_LINKS.map(({ href, label, svg }) => {
      const active = pathname === href || pathname.startsWith(href + '/');
      return (
        <div class="shrink-0 min-w-0">
        <a
          href={href}
          aria-current={active ? 'page' : undefined}
          class:list={[
            'flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors',
            active
              ? 'bg-[var(--color-accent)]/25 text-[var(--color-accent)] border border-[var(--color-accent)]/30'
              : 'text-[var(--color-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-border)]/40',
          ]}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" set:html={svg} />
          {label}
        </a>
        {href === '/chat' && <WorkspaceChats client:load />}
        </div>
      );
    })}
  </nav>
  <div class="px-3 pb-4 pt-2 mt-auto shrink-0">
    <div class="border-t border-[var(--color-border)] pt-4 flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-[var(--color-accent)]/20 flex items-center justify-center text-xs font-semibold text-[var(--color-accent)] shrink-0">U</div>
      <div class="min-w-0 flex-1">
        <p class="text-sm text-[var(--color-text)] truncate">User</p>
      </div>
    </div>
  </div>
</aside>

<style is:global>
  .sidebar--open {
    display: flex !important;
    position: fixed;
    z-index: 50;
    top: 0;
    bottom: 0;
    left: 0;
    animation: sidebarIn 0.2s ease-out;
  }
  @keyframes sidebarIn {
    from { transform: translateX(-100%); }
    to { transform: translateX(0); }
  }
</style>
